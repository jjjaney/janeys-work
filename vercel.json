{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/case-studies",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/work-with-me",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/contact-janey",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/work-archives",
      "destination": "/archive/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(favicon.ico|favicon.svg|icons/(.*))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
